# Agente IA (Gemini) — la clave solo vive en el backend
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
AGENT_RATE_LIMIT_PER_MINUTE=15
# Sesiones (cookie HttpOnly). COOKIE_SECURE=false solo si un navegador rechaza cookies Secure en http://localhost
SESSION_TTL_HOURS=168
COOKIE_SECURE=true
# Notificaciones del formulario de contacto (sin SMTP_HOST solo se guardan en BD)
CONTACT_NOTIFY_TO=info@agropelink.es
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@agropelink.es
SMTP_STARTTLS=true

# Recuperación de contraseña: secreto JWT (genera uno con: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
PASSWORD_RESET_TTL_MINUTES=15
FRONTEND_URL=http://localhost:5173
