# --- Base de datos -------------------------------------------------------------------------------------
# Desarrollo: SQLite. Producción: TiDB / MySQL con el driver pymysql, por ejemplo:
# DATABASE_URL=mysql+pymysql://USUARIO:CONTRASEÑA@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/agropelink?charset=utf8mb4
# DATABASE_SSL_CA=/etc/ssl/certs/ca-certificates.crt
DATABASE_URL=sqlite:///./agropelink.db
DATABASE_SSL_CA=
ENVIRONMENT=development
# Orígenes permitidos por CORS (JSON). En producción, solo tu dominio.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Agente Agropelink AI ------------------------------------------------------------------------------
# auto (por defecto): Ollama si OLLAMA_URL está definido; si no, motor local.
# local  → reglas + datos de la cuenta. Gratis, instantáneo, nada sale del servidor.
# ollama → modelo abierto en TU servidor (https://ollama.com). Gratis; los datos no salen de tu infraestructura.
# gemini → Google Gemini. Envía la pregunta y el contexto mínimo a Google: úsalo solo si lo decides expresamente.
AGENT_ENGINE=auto
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
AGENT_RATE_LIMIT_PER_MINUTE=15
AGENT_RATE_LIMIT_PER_IP_PER_MINUTE=30
# Solo para AGENT_ENGINE=gemini o DOCUMENT_AI_USE_GEMINI=true. La clave solo vive en el backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
# Clasificación de documentos con Gemini (por defecto, extracción local sin terceros).
DOCUMENT_AI_USE_GEMINI=false

# --- Moderación del foro -------------------------------------------------------------------------------
# Advertencia en la 1.ª y 2.ª falta; bloqueo en la 3.ª. Las faltas caducan tras N horas sin infracciones (48–72).
MODERATION_BAN_AFTER_WARNINGS=3
MODERATION_WARNING_TTL_HOURS=72

# --- Almacenamiento privado (fuera de cualquier ruta servida) -------------------------------------------
UPLOAD_DIR=./storage/documents
FORUM_MEDIA_DIR=./storage/forum_media
FARM_PHOTO_DIR=./storage/farm_photos
TASK_MEDIA_DIR=./storage/task_media

# --- Sesiones -----------------------------------------------------------------------------------------------
# Cookie HttpOnly. COOKIE_SECURE=false solo si un navegador rechaza cookies Secure en http://localhost
SESSION_TTL_HOURS=168
COOKIE_SECURE=true

# --- Notificaciones del formulario de contacto (sin SMTP_HOST solo se guardan en BD) ------------------------
CONTACT_NOTIFY_TO=info@agropelink.es
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@agropelink.es
SMTP_STARTTLS=true

# --- Recuperación de contraseña ----------------------------------------------------------------------------
# Secreto JWT (genera uno con: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
PASSWORD_RESET_TTL_MINUTES=15
FRONTEND_URL=http://localhost:5173
